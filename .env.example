ANTHROPIC_API_KEY=sk-ant-...

# Slack — required for digest delivery, priority DMs, and reaction feedback.
# Socket Mode: no public URL needed.
SLACK_BOT_TOKEN=              # xoxb-… Bot User OAuth Token
SLACK_APP_TOKEN=              # xapp-… App-Level Token (connections:write scope)
SLACK_USER_ID=                # U… your Slack member ID (Profile → ⋯ → Copy member ID)

# Storage
NEWS_AGENT_DB=./news_agent.db

# Timezone for scheduled runs when hosting with Docker (see deploy/README.md).
# Cron cadences fire at this local time. Ignored by the macOS launchd path.
TZ=Europe/Kyiv

# Models — fast tagger and smart scorer. Override only to pin a different version.
NEWS_AGENT_MODEL_FAST=claude-haiku-4-5-20251001
NEWS_AGENT_MODEL_SMART=claude-sonnet-4-6

# Cost cap (USD/month). Pipeline halts and warns on Slack when exceeded.
NEWS_AGENT_BUDGET_USD=5

# RSSHub — required only for Twitter/X list ingestion. See docker-compose.yml.
RSSHUB_BASE_URL=http://localhost:1200
# Twitter/X cookies: pull `auth_token` and `ct0` from your browser session.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Topics, sources, tag vocabulary, and scoring weights live in config/*.yaml
# (see `topics.yaml`, `sources.yaml`, `tags.yaml`, `source_priors.yaml`) — not env.
